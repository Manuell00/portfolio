---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { profile, ui } from "../../data/site";

export async function getStaticPaths() {
  return [{ params: { lang: "it" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const langUi = ui[lang];
const featuredExperience = profile.experience.filter((item) => item.featuredTop);
const workExperience = profile.experience.filter((item) => !item.featuredTop);
---

<BaseLayout
  lang={lang}
  title={`${profile.name} | ${profile.shortRole[lang].join(" · ")}`}
  description={profile.role[lang]}
>
  <Hero lang={lang} />

  <section class="content-grid section-space">
    <div class="content-card expertise-card" data-reveal>
      <h2 class="section-title">{profile.webAi.title[lang]}</h2>
      <p class="desktop-copy">{profile.webAi.body[lang]}</p>
      <p class="mobile-copy">{profile.webAi.mobileBody[lang]}</p>
      <div class="feature-icons">
        {profile.webAi.points.map((point) => (
          <div class="feature-tile">
            <span class="feature-icon">{point.icon}</span>
            <small>{point[lang]}</small>
          </div>
        ))}
      </div>
      <div class="showcase-collage">
        <a class="showcase-card showcase-card-hospitality" href={`/${lang}/projects/#la-terrazza-affittacamere`}>
          <img src="/la-terrazza-cover.png" alt="La Terrazza Affittacamere" loading="lazy" class="showcase-media" />
          <div class="showcase-caption">
            <span>La Terrazza</span>
            <small>{lang === "it" ? "Affittacamere" : "Guesthouse website"}</small>
          </div>
        </a>
        <a class="showcase-card showcase-card-analysis" href={`/${lang}/projects/#marosa-house-website`}>
          <img src="/marosa-gallery-1.jpg" alt="MaRoSa House" loading="lazy" class="showcase-media" />
          <div class="showcase-caption">
            <span>MaRoSa House</span>
            <small>{lang === "it" ? "Sito hospitality" : "Hospitality website"}</small>
          </div>
        </a>
        <a class="showcase-card showcase-card-web" href={`/${lang}/projects/#rolecha-company`}>
          <img src="/rolecha-card-cover.jpg" alt="Rolecha Company" loading="lazy" class="showcase-media" />
          <div class="showcase-caption">
            <span>Rolecha Company</span>
            <small>{lang === "it" ? "Sito corporate" : "Corporate website"}</small>
          </div>
        </a>
        <div class="showcase-badge">{langUi.showcaseBadge}</div>
      </div>
    </div>

    <div class="content-card skills-card" id="skills" data-reveal>
      <h2 class="section-title">{langUi.skillsTitle}</h2>
      <div class="skills-groups">
        {profile.skillGroups.map((group) => (
          <article class="skill-group">
            <h3>{group.title[lang]}</h3>
            <ul class="skill-cloud compact">
              {group.items.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="section-heading section-heading-centered mobile-clean-heading" data-reveal>
      <h2 class="section-title">{langUi.highlightsTitle}</h2>
      <p>{langUi.highlightsCopy}</p>
    </div>

    <div class="carousel-shell carousel-shell-highlights" data-content-carousel data-reveal>
      <div class="carousel-frame">
        <div class="carousel-viewport" data-carousel-viewport>
          <div class="highlight-grid carousel-track">
            {profile.highlights.map((item) => (
              <article class="highlight-card carousel-card">
                <div class="highlight-topline">
                  <span class:list={[
                    "highlight-badge",
                    item.icon === "XL"
                      ? "highlight-badge-excel"
                      : item.icon === "DB"
                        ? "highlight-badge-db"
                        : item.icon === "MG"
                          ? "highlight-badge-erp"
                          : "highlight-badge-hospitality",
                  ]}>
                    {item.tags[0]}
                  </span>
                  <span class="highlight-arrow" aria-hidden="true">↗</span>
                </div>
                <h3>{item.title[lang]}</h3>
                <p>{item.body[lang]}</p>
                <ul class="tag-list">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-button"
          data-carousel-prev
          aria-label={lang === "it" ? "Scorri indietro nelle aree di valore" : "Scroll back through value areas"}
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          class="carousel-button"
          data-carousel-next
          aria-label={lang === "it" ? "Scorri avanti nelle aree di valore" : "Scroll forward through value areas"}
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="section-heading section-heading-centered mobile-clean-heading" data-reveal>
      <h2 class="section-title">{langUi.experienceTitle}</h2>
      <p>{langUi.experienceCopy}</p>
    </div>

    <div class="carousel-shell carousel-shell-featured" data-content-carousel data-reveal>
      <div class="carousel-meta">
        <div class="experience-group-heading">
          <span>{lang === "it" ? "Formazione e progetti attivi" : "Learning and active projects"}</span>
        </div>
        <div class="carousel-controls">
          <button
            type="button"
            class="carousel-button"
            data-carousel-prev
            aria-label={lang === "it" ? "Scorri indietro nella sezione formazione e progetti attivi" : "Scroll back through learning and active projects"}
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="carousel-button"
            data-carousel-next
            aria-label={lang === "it" ? "Scorri avanti nella sezione formazione e progetti attivi" : "Scroll forward through learning and active projects"}
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="carousel-frame">
        <div class="carousel-viewport" data-carousel-viewport>
          <div class="experience-featured-grid carousel-track">
            {featuredExperience.map((item) => (
              <article class:list={["timeline-item", "timeline-item-top", "carousel-card", item.featured && "timeline-item-featured"]}>
                <div class="timeline-node"></div>
                <span class="timeline-period">{item.period[lang]}</span>
                <h3>
                  {item.title[lang]}
                  {item.company?.[lang] && <span class="timeline-company"> {lang === "it" ? "—" : "—"} {item.company[lang]}</span>}
                </h3>
                <ul class="timeline-tags">
                  {item.details[lang].map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="carousel-shell carousel-shell-timeline" data-content-carousel data-reveal>
      <div class="carousel-meta">
        <div class="experience-group-heading">
          <span>{lang === "it" ? "Percorso professionale" : "Work journey"}</span>
        </div>
        <div class="carousel-controls">
          <button
            type="button"
            class="carousel-button"
            data-carousel-prev
            aria-label={lang === "it" ? "Scorri indietro nel percorso professionale" : "Scroll back through work journey"}
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="carousel-button"
            data-carousel-next
            aria-label={lang === "it" ? "Scorri avanti nel percorso professionale" : "Scroll forward through work journey"}
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="carousel-frame">
        <div class="carousel-viewport" data-carousel-viewport>
          <div class="timeline-sequence carousel-track">
            {workExperience.map((item) => (
              <article class:list={["timeline-item", "carousel-card", item.featured && "timeline-item-featured"]}>
                <div class="timeline-node"></div>
                <span class="timeline-period">{item.period[lang]}</span>
                <h3>
                  {item.title[lang]}
                  {item.company?.[lang] && <span class="timeline-company"> {lang === "it" ? "—" : "—"} {item.company[lang]}</span>}
                </h3>
                <ul class="timeline-tags">
                  {item.details[lang].map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const initContentCarousels = () => {
      const carousels = Array.from(document.querySelectorAll("[data-content-carousel]"));

      carousels.forEach((carousel) => {
        const viewport = carousel.querySelector("[data-carousel-viewport]");
        const prevButton = carousel.querySelector("[data-carousel-prev]");
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const cards = Array.from(carousel.querySelectorAll(".carousel-card"));

        if (!viewport || !cards.length) return;

        const getStep = () => {
          const firstCard = cards[0];
          const secondCard = cards[1];

          if (firstCard && secondCard) {
            return secondCard.offsetLeft - firstCard.offsetLeft;
          }

          return firstCard.getBoundingClientRect().width;
        };

        const update = () => {
          const maxScroll = Math.max(viewport.scrollWidth - viewport.clientWidth, 0);

          if (prevButton) {
            prevButton.disabled = viewport.scrollLeft <= 8;
          }

          if (nextButton) {
            nextButton.disabled = viewport.scrollLeft >= maxScroll - 8;
          }
        };

        const move = (direction) => {
          viewport.scrollBy({
            left: getStep() * direction,
            behavior: "smooth",
          });
        };

        prevButton?.addEventListener("click", () => move(-1));
        nextButton?.addEventListener("click", () => move(1));
        viewport.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        viewport.scrollLeft = 0;
        update();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initContentCarousels, { once: true });
    } else {
      initContentCarousels();
    }
  </script>
</BaseLayout>
