---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { profile, projects, ui } from "../../data/site";

export async function getStaticPaths() {
  return [{ params: { lang: "it" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const langUi = ui[lang];
const personalProjects = projects.filter((project) => project.category === "personal");
const commissionedProjects = projects.filter((project) => project.category === "commissioned");
const personalLabel = lang === "it" ? "Progetti personali" : "Personal projects";
const commissionedLabel = lang === "it" ? "Lavori commissionati" : "Commissioned work";
---

<BaseLayout
  lang={lang}
  title={`${profile.name} | ${langUi.projectsPageTitle}`}
  description={langUi.projectsPageCopy}
>
  {personalProjects.length > 0 && (
    <section class="section-space project-section-personal">
      <div class="project-group-heading" data-reveal>
        <h2 class="project-group-title">{personalLabel}</h2>
      </div>

      <section class="project-grid project-grid-group">
        {personalProjects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </section>
    </section>
  )}

  {commissionedProjects.length > 0 && (
    <section class="section-space project-section-commissioned">
      <div class="project-group-heading" data-reveal>
        <h2 class="project-group-title">{commissionedLabel}</h2>
      </div>

      <section class="project-grid project-grid-group">
        {commissionedProjects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </section>
    </section>
  )}

  <script is:inline>
    const galleries = Array.from(document.querySelectorAll("[data-project-gallery]"));

    galleries.forEach((gallery) => {
      const shell = gallery.closest(".project-gallery-shell");
      const prev = shell?.querySelector("[data-project-prev]");
      const next = shell?.querySelector("[data-project-next]");
      const dots = Array.from(shell?.querySelectorAll("[data-project-dot]") || []);

      const updateDots = () => {
        const slides = Array.from(gallery.querySelectorAll(".project-shot"));
        if (!slides.length || !dots.length) return;
        const galleryRect = gallery.getBoundingClientRect();
        const galleryCenter = galleryRect.left + galleryRect.width / 2;

        let activeIndex = 0;
        let smallestDistance = Number.POSITIVE_INFINITY;

        slides.forEach((slide, index) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const distance = Math.abs(slideCenter - galleryCenter);
          if (distance < smallestDistance) {
            smallestDistance = distance;
            activeIndex = index;
          }
        });

        dots.forEach((dot, index) => {
          dot.classList.toggle("is-active", index === activeIndex);
        });
      };

      const move = (direction) => {
        const firstSlide = gallery.querySelector(".project-shot");
        if (!firstSlide) return;
        const gap = parseFloat(getComputedStyle(gallery).gap || "0");
        const amount = firstSlide.getBoundingClientRect().width + gap;
        gallery.scrollBy({ left: amount * direction, behavior: "smooth" });
      };

      prev?.addEventListener("click", () => move(-1));
      next?.addEventListener("click", () => move(1));

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const index = Number(dot.dataset.projectIndex || "0");
          const target = gallery.querySelectorAll(".project-shot")[index];
          target?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
        });
      });

      gallery.addEventListener("scroll", updateDots, { passive: true });
      window.addEventListener("resize", updateDots);
      updateDots();
    });
  </script>
</BaseLayout>
