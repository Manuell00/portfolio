---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { profile, ui } from "../../data/site";

export async function getStaticPaths() {
  return [{ params: { lang: "it" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const langUi = ui[lang];
const featuredExperience = profile.experience.filter((item) => item.featuredTop);
const workExperience = profile.experience.filter((item) => !item.featuredTop);
---

<BaseLayout
  lang={lang}
  title={`${profile.name} | ${profile.shortRole[lang].join(" · ")}`}
  description={profile.role[lang]}
>
  <Hero lang={lang} />

  <section class="content-grid section-space">
    <div class="content-card expertise-card" data-reveal>
      <span class="section-label">{langUi.expertiseTitle}</span>
      <h2 class="section-title">{profile.webAi.title[lang]}</h2>
      <p class="desktop-copy">{profile.webAi.body[lang]}</p>
      <p class="mobile-copy">{profile.webAi.mobileBody[lang]}</p>
      <div class="feature-icons">
        {profile.webAi.points.map((point) => (
          <div class="feature-tile">
            <span class="feature-icon">{point.icon}</span>
            <small>{point[lang]}</small>
          </div>
        ))}
      </div>
      <div class="showcase-collage" aria-hidden="true">
        <div class="showcase-card showcase-card-analysis showcase-placeholder">
          <span>Project visual 01</span>
          <small>Ready for your screenshot</small>
        </div>
        <div class="showcase-card showcase-card-web showcase-placeholder">
          <span>Project visual 02</span>
          <small>Ready for your screenshot</small>
        </div>
        <div class="showcase-badge">Ready for project visuals</div>
      </div>
    </div>

    <div class="content-card skills-card" id="skills" data-reveal>
      <span class="section-label">{langUi.skillsTitle}</span>
      <h2 class="section-title">{langUi.skillsTitle}</h2>
      <div class="skills-groups">
        {profile.skillGroups.map((group) => (
          <article class="skill-group">
            <h3>{group.title[lang]}</h3>
            <ul class="skill-cloud compact">
              {group.items.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="section-heading mobile-clean-heading" data-reveal>
      <span class="section-label">{langUi.highlightsTitle}</span>
      <h2 class="section-title">{langUi.highlightsTitle}</h2>
      <p>{langUi.highlightsCopy}</p>
    </div>

    <div class="highlight-grid" data-carousel-track>
      {profile.highlights.map((item) => (
        <article class="highlight-card" data-reveal data-carousel-item>
          <div class="highlight-topline">
            <span class:list={[
              "highlight-badge",
              item.icon === "XL"
                ? "highlight-badge-excel"
                : item.icon === "DB"
                  ? "highlight-badge-db"
                  : item.icon === "MG"
                    ? "highlight-badge-erp"
                    : "highlight-badge-hospitality",
            ]}>
              {item.tags[0]}
            </span>
            <span class="highlight-arrow" aria-hidden="true">↗</span>
          </div>
          <h3>{item.title[lang]}</h3>
          <p>{item.body[lang]}</p>
          <ul class="tag-list">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section-space">
    <div class="section-heading mobile-clean-heading" data-reveal>
      <span class="section-label">{langUi.experienceTitle}</span>
      <h2 class="section-title">{langUi.experienceTitle}</h2>
      <p>{langUi.experienceCopy}</p>
    </div>

    <div class="experience-group-heading mobile-only" data-reveal>
      <span>{lang === "it" ? "Formazione e progetti attivi" : "Learning and active projects"}</span>
    </div>
    <div class="experience-featured-grid" data-carousel-track>
      {featuredExperience.map((item) => (
        <article class:list={["timeline-item", "timeline-item-top", item.featured && "timeline-item-featured"]} data-reveal data-carousel-item>
          <div class="timeline-node"></div>
          <span class="timeline-period">{item.period[lang]}</span>
          <h3>
            {item.title[lang]}
            {item.company?.[lang] && <span class="timeline-company"> {lang === "it" ? "—" : "—"} {item.company[lang]}</span>}
          </h3>
          <ul class="timeline-tags">
            {item.details[lang].map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="experience-group-heading mobile-only" data-reveal>
      <span>{lang === "it" ? "Percorso professionale" : "Work journey"}</span>
    </div>
    <div class="timeline-sequence" data-carousel-track>
      {workExperience.map((item) => (
        <article class:list={["timeline-item", item.featured && "timeline-item-featured"]} data-reveal data-carousel-item>
          <div class="timeline-node"></div>
          <span class="timeline-period">{item.period[lang]}</span>
          <h3>
            {item.title[lang]}
            {item.company?.[lang] && <span class="timeline-company"> {lang === "it" ? "—" : "—"} {item.company[lang]}</span>}
          </h3>
          <ul class="timeline-tags">
            {item.details[lang].map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    const initCarousels = () => {
      const tracks = Array.from(document.querySelectorAll("[data-carousel-track]"));

      const setFocused = (track) => {
        const items = Array.from(track.querySelectorAll("[data-carousel-item]"));
        if (!items.length) return;

        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;

        let closest = items[0];
        let closestDistance = Number.POSITIVE_INFINITY;

        for (const item of items) {
          const rect = item.getBoundingClientRect();
          const itemCenter = rect.left + rect.width / 2;
          const distance = Math.abs(trackCenter - itemCenter);

          item.classList.remove("is-focused");

          if (distance < closestDistance) {
            closestDistance = distance;
            closest = item;
          }
        }

        closest.classList.add("is-focused");
      };

      for (const track of tracks) {
        const items = Array.from(track.querySelectorAll("[data-carousel-item]"));
        if (!items.length) continue;

        let raf = 0;
        const requestUpdate = () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => setFocused(track));
        };

        const observer = new IntersectionObserver(
          (entries) => {
            let best = null;
            let bestRatio = 0;

            for (const entry of entries) {
              if (entry.intersectionRatio > bestRatio) {
                bestRatio = entry.intersectionRatio;
                best = entry.target;
              }
            }

            if (best) {
              items.forEach((item) => item.classList.remove("is-focused"));
              best.classList.add("is-focused");
            } else {
              requestUpdate();
            }
          },
          {
            root: track,
            threshold: [0.35, 0.5, 0.65, 0.8, 0.95],
          },
        );

        items.forEach((item) => observer.observe(item));
        requestUpdate();
        track.addEventListener("scroll", requestUpdate, { passive: true });
        track.addEventListener("touchend", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCarousels, { once: true });
    } else {
      initCarousels();
    }
  </script>
</BaseLayout>
